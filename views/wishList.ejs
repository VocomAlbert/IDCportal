<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="shortcut icon" href="http://103.178.37.3:4001/img/vocom3.png" type="image/png">
  <title>VOCOM -IDC-</title>
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-table@1.23.4/dist/bootstrap-table.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" crossorigin="anonymous">
  <link rel="stylesheet" href="http://103.178.37.3:4001/css/navbar.css">
  <link rel="stylesheet" href="http://103.178.37.3:4001/css/style.css">
  <link rel="stylesheet" href="http://103.178.37.3:4001/css/dropdown.css">
</head>

<body>
  <div>
    <%- include navbar.ejs %>
    <% if ( flag == 1) { %>
      <script type="text/javascript">
        showAlert = function() {
          alert(`You request had been sent to VOCOM sales team!`);
        }
        showAlert();
      </script>
    <% } %>
    <% if ( flag == -1) { %>
      <script type="text/javascript">
        showAlert = function() {
          alert(`Special characters and words is not allowed!(!@#$%^&*+{}:&gt&lt?; delete insert update .etc)\r\nThe limit for "notes" or "location" is 500 characters. \r\n Please send it again!`);
        }
        showAlert();
      </script>
    <% } %>
    <% if ( flag == -2) { %>
      <script type="text/javascript">
        showAlert = function() {
          alert(`At least "Avail Power" should be fill in!\r\n Please send it again!`);
        }
        showAlert();
      </script>
    <% } %>
    <input type ="checkbox" id="right-text-switch">
    <div class="right-text-container">
      <div class="error-content right-text-alert mx-1 mb-3">
        <i class="fa-solid fa-bell me-1"></i>
        If you have identified a matching IDC or a new IDC requirement, please fill out the form and we will contact you.
      </div>
      <!-- IDC information here -->
      <div class="right-text m-1">
        <form class="row g-4 justify-content-center" name="modifyIdcInfo" method="post" action="/idcwebsite/wishList" onsubmit="return confirm('Do you really want to submit the form?');">
          <div class="input-item col-5">
            <div class="input-title">
              <label>Requested Location</label>
              <span>Country or City</span>
            </div>
            <input class="form-control" type="text" name="location_wishList">
          </div>
          <div class="input-item col-5">
            <div class="input-title">
              <label>Required Avail Power</label>
              <span>Megawatt</span>
            </div>
            <input class="form-control" type="number" step="0.1" min="0" name="powerAvail_MW_wishList" required="required">
          </div>
          <div class="input-item col-5">
            <div class="input-title">
              <label>Target Power Price</label>
              <span>USD/Kilowatt</span>
            </div>
            <input class="form-control" type="number" step="0.01" min="0" name="powerPrice_KW_Hour_wishList" required="required">
          </div>
          <div class="input-item col-5">
            <div class="input-title">
              <label>Target Space Price</label>
              <span>USD/Kilowatt</span>
            </div>
            <input class="form-control" type="number" step="10" min="0" name="spacePrice_KW_wishList" required="required">
          </div>
          <div class="input-item col-5">
            <div class="input-title">
              <label>Max Power per Rack</label>
              <span>Kilowatt</span>
            </div>
            <input class="form-control" type="number" step="1" min="0" name="rackMax_KW_wishList" required="required">
          </div>
          <div class="input-item col-5">
            <div class="input-title">
              <label>Liquid Cooling</label>
              <span>Ready or not</span>
            </div>
            <select class="form-select" name="liquidCoolingReady_wishList" id="liquidCoolingReady_wishList">
              <option value='0'>No requirement</option>
              <option value='1'>Yes</option>
              <option value='-1'>No</option>
            </select>
          </div>
          <div class="input-item col-5">
            <div class="input-title">
              <label>Deployment Date</label>
              <span>Year/Quarter</span>
            </div>
            <select class="form-select" name="deploymentDate_wishList" id="deploymentDate_wishList">
              <option value='No requirement'> No requirement</option>
              <%for (let i=0;i<dateList.length ; i++) { %>
                <option value="<%=dateList[i]%>"><%=dateList[i]%></option>
              <% } %>  
            </select>
          </div>
          <div class="input-item col-5"></div>
          <div class="input-item col-10">
            <div class="input-title">
              <label>Remark</label>
              <span>Special requirement</span>
            </div>
            <textarea class="form-control" type="text" name="remark_wishList" style="height: 100px;"></textarea>
          </div>
          <div class="col-10 d-flex justify-content-end">
              <button class="btn btn-primary" type="submit">
                Submit
              </button>
          </div>
        </form>
      </div>
    </div>
  </div> 
  

  <script src="https://cdn.jsdelivr.net/npm/jquery/dist/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.23.4/dist/bootstrap-table.min.js"></script>
</body>

</html>




