<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link rel="shortcut icon" href="http://103.178.37.3:4001/img/vocom3.png" type="image/png">
    <title>VOCOM -IDC-</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="http://103.178.37.3:4001/css/style.css">
    <link rel="stylesheet" href="http://103.178.37.3:4001/css/login.css">
    
    
</head>
<body>
    <!-- partial:index.partial.html -->
    <div id="bg"></div>
    
    <form class="form-signin login-window" role="form" method="post" action="/idcwebsite">
        <div class="text-center">
            <img src="http://103.178.37.3:4001/img/vocom.png">
        </div>
        <div class="row g-2 flex-column">
            <div class="input-item col">
                <div class="input-title">
                  <label>Account</label>
                </div>
                <div class="input-text">
                    <input class="form-control" id='account' name='account' type="text" required />
                    <span><i class="fa-solid fa-user"></i></span>
                </div>
            </div>
            <div class="input-item col mb-2">
                <div class="input-title">
                  <label>Password</label>
                </div>
                <div class="input-text">
                    <input class="form-control" id='passWord' name='passWord' type="password" required /> 
                    <span><i class="fa-solid fa-lock"></i></span>
                </div>
            </div>
            <div class="col">
                <div class="account-error">
                    <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
                    Log in fail. Please check your account and password.
                </div>
            </div>
            <div class="mt-3">
                <button id="btnSub" class="btn btn-primary w-100" type="submit" value="login">
                    Sign in
                </button>
            </div>
        </div>
    </form>

    <!-- partial -->

</body>

</html>