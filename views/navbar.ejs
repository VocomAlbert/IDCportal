<script src="https://cdn.jsdelivr.net/npm/jquery/dist/jquery.min.js"></script>
<script>
  function checker(){
        if( confirm("Are you trying to logout? You will lose all the temporary information during the login this time.")){
          window.location.href="/idcwebsite/logout"
        } 
    }

    function toggleCheckboxes() {
      var checkbox1 = document.getElementById("side-menu-switch");
      var checkbox2 = document.getElementById("right-text-switch");
      checkbox1.checked = !checkbox1.checked;
      checkbox2.checked = checkbox1.checked;
    }
  
    $(document).ready(function() {
    // 獲取當前頁面的名稱，例如從 URL 中提取
    var currentPage = window.location.pathname.split('/').pop().split('.')[0]; // 假設頁面以 .html 結尾
    $('.nav li[data-page="' + currentPage + '"] a').addClass('active');
    console.log('currentPage' , currentPage);
});
</script>

<div class="top-nav">
  <div class="nav-container">
    <div class="top-nav-li">
      <a href="/idcwebsite/main"><img src="http://103.178.37.3:4001/img/vocom2.png" width="175" height="32" alt="" loading="lazy"></a>
    </div>
    <div class="logout">
      <div class="mx-3"><i class="fa-solid fa-user" aria-hidden="true"></i>&nbsp;<%= account %></div>
      <button class="btn btn-secondary" onclick='checker()'>Log out</button>
    </div>
  </div>
</div>

<input type ="checkbox" id="side-menu-switch">

<div class="side-menu">
  <div class="title">- IDC -</div>
  <ul class="nav">
    <% if (accountLevel <= 1 || accountLevel == 3) { %>
    <li data-page="idcInfo">
      <a href="/idcwebsite/idcInfo">
        <!-- <i class="fa fa-globe" aria-hidden="true"></i>  -->
        IDC Information</a>
    </li>
    <li data-page="wishList">
      <a href="/idcwebsite/wishList">
        <!-- <i class="fa fa-globe" aria-hidden="true"></i>  -->
        IDC Request Form</a>
    </li>
    <% } %>
    <% if (accountLevel <= 1 || accountLevel == 2) { %>
      <li data-page="modifyIdcInfo">
        <a href="/idcwebsite/modifyIdcInfo">
          <!-- <i class="fa fa-globe" aria-hidden="true"></i>  -->
          Modify IDC Info</a>
      </li>
    <% } %>
    <% if (account != 'VOCOMIDC' ){%>
    <li data-page="account">
      <a href="/idcwebsite/account">
        <!-- <i class="fa fa-plane" aria-hidden="true"></i>  -->
        Account</a>
    </li>
    <% } %>
  </ul>
  <label for="side-menu-switch right-text-switch" id="#changeWidth" onclick="toggleCheckboxes()">
    <i class="fa fa-angle-left" aria-hidden="true"></i>
  </label>
  
</div>

