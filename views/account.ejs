<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="http://103.178.37.3:4001/img/vocom3.svg" type="image/svg">
    <title>VOCOM -IDC-</title>
    
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-table@1.23.4/dist/bootstrap-table.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="http://103.178.37.3:4001/css/navbar.css">
    <link rel="stylesheet" href="http://103.178.37.3:4001/css/style.css">
</head>


<body>
  <div>
    <%- include navbar.ejs %>
  </div>
  <input type ="checkbox" name="" id="right-text-switch">
  <div class="right-text-container">
    <div class="right-text">
      <form class="row g-4 flex-column justify-content-center align-items-center py-3" name="account_update" method="post" action="/idcwebsite/account">
        <div class="input-item col-6">
            <div class="input-title">
              <label>User Name</label>
            </div>
            <input class="form-control" type="text" value="<%= account%>" id="account" disabled>
        </div>
        <div class="input-item col-6">
            <div class="input-title">
              <label>Original Password</label>
            </div>
            <div class="input-text">
                <input class="form-control" type="password" id="oldPassword" name="account_oldPassword" required oninvalid="this.setCustomValidity('Original password should be filled')" oninput="this.setCustomValidity('')">
                <img src="http://103.178.37.3:4001/img/eye-slash.svg" id="oldPasswordeyeicon">
            </div>
        </div>
        <div class="input-item col-6">
            <div class="input-title">
              <label>New Password</label>
            </div>
            <div class="input-text">
                <input class="form-control" type="password" id="newPassword" name="account_newPassword" required oninvalid="this.setCustomValidity('New password should be filled')" oninput="this.setCustomValidity('')">
                <img src="http://103.178.37.3:4001/img/eye-slash.svg" id="newPasswordeyeicon">
            </div>
        </div>
        <div class="input-item col-6">
            <div class="input-title">
              <label>Confirm New Password</label>
            </div>
            <div class="input-text">
                <input class="form-control" type="password" id="confirmPassword" name="account_confirmPassword" required oninvalid="this.setCustomValidity('Confirm new password should be filled')" oninput="this.setCustomValidity('')">
                <img src="http://103.178.37.3:4001/img/eye-slash.svg" id="confirmPasswordeyeicon">
            </div>
        </div>
        
    <% if (account_changePasswordResult == 1) { %>
        <div class="col-6">
            <div class="account-error">
                <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
                Change password failed. Password should not include the following special characters:
                <span>
                    !@#$%^&amp;*()+{}:><?,./;
                </span>
            </div>
        </div>
    <% } else if (account_changePasswordResult == 2) { %>
        <div class="col-6">
            <div class="account-error">
                <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
                Change password failed. The original password is not correct.
            </div>
        </div>
    <% } else if (account_changePasswordResult == 3) { %>
        <div class="col-6">
            <div class="account-error">
                <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
                Change password failed. The new password should not be the same as original password.
            </div>
        </div>
    <% } else if (account_changePasswordResult == 4){ %>
        <div class="col-6">
            <div class="account-error">
                <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
                Change password failed. The confirm password is not the same as the new password.
            </div>
        </div>
    <% } %>
        <div class="col-6 d-flex justify-content-end">
            <button class="btn btn-primary" type="submit" onclick="change()">
                Save
            </button>
        </div>
    </form>


    </div>
  </div>
  <script>
    let oldPasswordeyeicon = document.getElementById("oldPasswordeyeicon")
    let oldPassword = document.getElementById("oldPassword");

    oldPasswordeyeicon.onclick = function(){
        if(oldPassword.type == "password"){
            oldPassword.type = "text";
            oldPasswordeyeicon.src = "http://103.178.37.3:4001/img/eye-open.svg"
        }else{
            oldPassword.type = "password"
            oldPasswordeyeicon.src = "http://103.178.37.3:4001/img/eye-slash.svg"
        }
    }

    let newPasswordeyeicon = document.getElementById("newPasswordeyeicon")
    let newPassword = document.getElementById("newPassword");

    newPasswordeyeicon.onclick = function(){
        if(newPassword.type == "password"){
            newPassword.type = "text";
            newPasswordeyeicon.src = "http://103.178.37.3:4001/img/eye-open.svg"
        }else{
            newPassword.type = "password"
            newPasswordeyeicon.src = "http://103.178.37.3:4001/img/eye-slash.svg"
        }
    }

    let confirmPasswordeyeicon = document.getElementById("confirmPasswordeyeicon")
    let confirmPassword = document.getElementById("confirmPassword");

    confirmPasswordeyeicon.onclick = function(){
        if(confirmPassword.type == "password"){
            confirmPassword.type = "text";
            confirmPasswordeyeicon.src = "http://103.178.37.3:4001/img/eye-open.svg"
        }else{
            confirmPassword.type = "password"
            confirmPasswordeyeicon.src = "http://103.178.37.3:4001/img/eye-slash.svg"
        }
    }

    function change(){
        if( alert("If the password change excuted successfully, this portal will send you to the login page. Please login with new password again.")){
        } 
    }

</script>
<script src="https://cdn.jsdelivr.net/npm/jquery/dist/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.23.4/dist/bootstrap-table.min.js"></script>
</body>
</html>